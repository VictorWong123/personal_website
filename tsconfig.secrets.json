{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "checkJs": true,
        "jsx": "react-jsx",
        "lib": ["DOM", "ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "target": "ES2022",
        "types": ["vite/client"]
    },
    "include": ["src/secrets/**/*.js", "src/secrets/**/*.jsx"],
    "exclude": ["src/secrets/**/*.test.js"]
}
